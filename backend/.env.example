# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=qwen3.7-flash

# API密钥
LLM_API_KEY=

# 服务地址
LLM_BASE_URL=

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=300

# 新原生多智能体入口（尚未接入正式规划流程）
MASTER_LLM_MODEL_ID=kimi-k3
SUBAGENT_LLM_MODEL_ID=glm-5.3-flash
# 所有角色共用 LLM_BASE_URL / LLM_API_KEY，OPENAI_* 仅兜底；模型ID不继承 LLM_MODEL_ID。

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 高德地图API配置
AMAP_API_KEY=

# 正式关系存储；数据库凭据不要提交或打印
STORAGE_BACKEND=postgresql
DATABASE_URL=postgresql://trip_user:change_me@127.0.0.1:5432/trip_database
# 本地与生产须使用不同schema前缀
DATABASE_SCHEMA_PREFIX=trip_local
