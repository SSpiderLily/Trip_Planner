# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=qwen3.8-flash

# API密钥
LLM_API_KEY=

# 服务地址
LLM_BASE_URL=

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=300

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 高德地图API配置
AMAP_API_KEY=
